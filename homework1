#include <stdio.h>

#define MAX 100

/* Прототипы функций */
void input(int a[], int n);
void print(const int a[], int n);
int minVal(const int a[], int n);
int maxVal(const int a[], int n);
long long sumArr(const int a[], int n);
double avgArr(const int a[], int n);
void localMax(const int a[], int n);

int main(void) {
    int arr[MAX], n;

    /* 1. Запрос размера и проверка диапазона */
    printf("Размер массива (1–%d): ", MAX);
    if (scanf("%d", &n) != 1 || n < 1 || n > MAX) {
        printf("Ошибка: недопустимый размер массива.\n");
        return 1;
    }

    input(arr, n);
    printf("\nМассив: ");
    print(arr, n);
    printf("\n");

    /* Поиск минимума и максимума + их первых индексов (одним проходом) */
    int mn = arr[0], mx = arr[0];
    int imn = 0, imx = 0;
    for (int i = 1; i < n; ++i) {
        if (arr[i] < mn) { mn = arr[i]; imn = i; }
        if (arr[i] > mx) { mx = arr[i]; imx = i; }
    }
    printf("Мин: %d (индекс %d)\n", mn, imn);
    printf("Макс: %d (индекс %d)\n", mx, imx);

    long long s = sumArr(arr, n);
    double a = avgArr(arr, n);
    printf("Сумма: %lld\n", s);
    printf("Среднее: %.2f\n", a);

    /* Подсчёт знаков и чётности (одним проходом) */
    int pos = 0, neg = 0, zero = 0, even = 0, odd = 0;
    for (int i = 0; i < n; ++i) {
        if (arr[i] > 0) ++pos; else if (arr[i] < 0) ++neg; else ++zero;
        (arr[i] % 2 == 0) ? ++even : ++odd;
    }
    printf("Положит: %d, отрицат: %d, нули: %d\n", pos, neg, zero);
    printf("Чётные: %d, нечётные: %d\n", even, odd);

    /* 2. Запрос диапазона [a, b] — ровно один раз */
    int aL, bR;
    printf("Границы диапазона [a b]: ");
    if (scanf("%d %d", &aL, &bR) != 2) {
        printf("Ошибка ввода диапазона.\n");
        return 1;
    }
    if (aL > bR) { int t = aL; aL = bR; bR = t; }

    printf("В диапазоне [%d, %d]: ", aL, bR);
    int found = 0;
    for (int i = 0; i < n; ++i)
        if (arr[i] >= aL && arr[i] <= bR) {
            printf("%d ", arr[i]);
            found = 1;
        }
    if (!found) printf("нет элементов в массиве");
    printf("\n");

    localMax(arr, n);

    return 0;
}

/* Ввод n элементов с проверкой */
void input(int a[], int n) {
    printf("Введите %d чисел: ", n);
    for (int i = 0; i < n; ++i) {
        while (scanf("%d", &a[i]) != 1) {
            while (getchar() != '\n');
            printf("Повторите ввод: ");
        }
    }
}

/* Вывод массива в одну строку */
void print(const int a[], int n) {
    for (int i = 0; i < n; ++i) printf("%d ", a[i]);
}

/* Минимальный элемент */
int minVal(const int a[], int n) {
    int m = a[0];
    for (int i = 1; i < n; ++i)
        if (a[i] < m) m = a[i];
    return m;
}

/* Максимальный элемент */
int maxVal(const int a[], int n) {
    int m = a[0];
    for (int i = 1; i < n; ++i)
        if (a[i] > m) m = a[i];
    return m;
}

/* Сумма элементов */
long long sumArr(const int a[], int n) {
    long long s = 0;
    for (int i = 0; i < n; ++i) s += a[i];
    return s;
}

/* Среднее арифметическое */
double avgArr(const int a[], int n) {
    return (double)sumArr(a, n) / n;
}

/* Индивидуальное задание: элементы больше обоих соседей */
void localMax(const int a[], int n) {
    printf("Больше соседей: ");
    int found = 0;
    for (int i = 1; i < n - 1; ++i)
        if (a[i] > a[i - 1] && a[i] > a[i + 1]) {
            printf("%d ", a[i]);
            found = 1;
        }
    if (!found) printf("нет таких элементов");
    printf("\n");
}
